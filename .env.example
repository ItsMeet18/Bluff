# Upstash Redis / Vercel KV Credentials
# These are automatically populated when you add Upstash Redis or Vercel KV to your Vercel project:
UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_rest_token"

# Alternatively, standard Vercel KV environment variables are also supported automatically:
# KV_REST_API_URL="https://your-kv-instance.upstash.io"
# KV_REST_API_TOKEN="your_kv_rest_token"
